@startuml
'https://plantuml.com/class-diagram

interface ShootStrategy {
    + {abstract} shoot(int x, int y, int speedx, int speedy, int angle, int power)
}

class NullShoot implements ShootStrategy {
    + shoot(int x, int y, int speedx, int speedy, int angle, int power)
}

class DirectShoot implements ShootStrategy {
    + shoot(int x, int y, int speedx, int speedy, int angle, int power)
}

class DoubleShoot implements ShootStrategy {
    + shoot(int x, int y, int speedx, int speedy, int angle, int power)
}

class ScatterShoot implements ShootStrategy {
    + shoot(int x, int y, int speedx, int speedy, int angle, int power)
}

class CircleShoot implements ShootStrategy {
    + shoot(int x, int y, int speedx, int speedy, int angle, int power)
}

class AbstractAircraft {
    + shootStrategy: ShootStrategy
    + setShootStrategy(ShootStrategy shootStrategy)
    + executeShootStrategy() : List<Bullet>
}

AbstractAircraft o--> ShootStrategy

@enduml